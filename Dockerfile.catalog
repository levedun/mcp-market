# Catalog viewer only (SQLite + static UI). Not the MCP browser server.
FROM node:22-bookworm-slim

WORKDIR /home/mcp-market

COPY src/catalog ./src/catalog
COPY scripts/catalog-serve.mjs ./scripts/catalog-serve.mjs
COPY catalog-web ./catalog-web

ENV CATALOG_BIND=0.0.0.0
ENV PORT=3847
ENV MARKET_CATALOG_DB=/home/mcp-market/data/catalog.db

EXPOSE 3847

CMD ["node", "scripts/catalog-serve.mjs"]
